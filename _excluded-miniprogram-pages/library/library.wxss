/* pages/library/library.wxss */
page {
  background: #FFFFFF;
}

.section-heading {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.section-subtitle {
  margin-top: 8rpx;
}

.placeholder-card {
  padding: 72rpx 32rpx;
  text-align: center;
}

.placeholder-title {
  display: block;
  color: #24292F;
  font-size: 34rpx;
  font-weight: 600;
}

.placeholder-description {
  display: block;
  margin-top: 12rpx;
  color: #57606A;
  font-size: 26rpx;
  line-height: 1.5;
}
