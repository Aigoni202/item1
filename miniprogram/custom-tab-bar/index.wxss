.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #ece9e1;
  box-shadow: 0 -8rpx 24rpx rgba(34, 37, 42, .05);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #707672;
  transition: transform 140ms ease, opacity 140ms ease;
}
.tab-item:active { opacity: .72; transform: scale(.94); }
.tab-icon { width: 42rpx; height: 42rpx; margin-bottom: 4rpx; }
.tab-label { font-size: 23rpx; line-height: 32rpx; font-weight: 600; }
.is-selected { color: #147d73; }
.is-selected .tab-label { font-weight: 700; }
