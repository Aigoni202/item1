/* 管理后台管理员页样式 */
page {
  background: #f6f8fa;
}

.admins-page {
  min-height: 100vh;
}

.permission-card {
  margin-top: 40rpx;
  text-align: center;
}

.permission-title {
  display: block;
  color: #24292f;
  font-size: 32rpx;
  font-weight: 600;
}

.permission-description {
  display: block;
  margin-top: 12rpx;
  color: #57606a;
  font-size: 24rpx;
  line-height: 1.5;
}

.admin-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
}

.add-button {
  min-width: 120rpx;
  min-height: 68rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.add-form {
  margin-bottom: 20rpx;
}

.permission-form {
  margin-bottom: 20rpx;
}

.permission-description {
  margin-top: 8rpx;
  color: #57606a;
  font-size: 22rpx;
}

.form-title {
  color: #24292f;
  font-size: 28rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 78rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  color: #24292f;
  background: #fff;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  font-size: 25rpx;
}

.role-options {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.role-option {
  flex: 1;
  padding: 18rpx 8rpx;
  color: #57606a;
  background: #f6f8fa;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  font-size: 23rpx;
  text-align: center;
}

.role-option.active {
  color: #0969da;
  background: #ddf4ff;
  border-color: #0969da;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.form-button {
  flex: 1;
  min-height: 76rpx;
}

.admin-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.admin-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.admin-main {
  min-width: 0;
}

.admin-name {
  color: #24292f;
  font-size: 29rpx;
  font-weight: 600;
}

.admin-role {
  margin-top: 8rpx;
  color: #57606a;
  font-size: 23rpx;
}

.admin-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
}

.status {
  font-size: 22rpx;
}

.status-active {
  color: #1a7f37;
}

.status-disabled {
  color: #cf222e;
}

.small-button {
  min-height: 60rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
}
