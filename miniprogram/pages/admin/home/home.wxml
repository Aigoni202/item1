<!-- pages/admin/home/home.wxml -->
<view class="page admin-page">
  <view class="page-content">
    <view class="admin-header">
      <view>
        <view class="section-title">管理后台</view>
        <view class="section-subtitle">你好，{{username}}</view>
      </view>
      <button class="btn-secondary logout-button" bindtap="logout">退出</button>
    </view>

    <view class="section-heading">
      <text class="section-title">功能入口</text>
      <text class="section-subtitle">选择需要管理的内容</text>
    </view>

    <view class="menu-list">
      <view
        class="card menu-item {{item.id === 'admins' && role !== 'super' ? 'menu-item-disabled' : ''}}"
        wx:for="{{menuList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onMenuTap"
      >
        <view class="menu-item-main">
          <view class="menu-item-title">{{item.title}}</view>
          <view class="menu-item-description">{{item.description}}</view>
        </view>
        <text wx:if="{{item.id !== 'admins' || role === 'super'}}" class="menu-item-arrow">›</text>
        <text wx:else class="menu-item-tag">仅超级管理员</text>
      </view>
    </view>
  </view>
</view>
