<!-- 管理员首页菜单 -->
<view class="page admin-index-page">
  <view class="page-content">
    <view class="admin-header">
      <view>
        <text class="section-title">管理后台</text>
        <text class="section-subtitle">你好，{{username}}</text>
      </view>
      <button class="btn-secondary logout-button" bindtap="logout">退出</button>
    </view>

    <view class="section-heading">
      <text class="section-title">功能入口</text>
      <text class="section-subtitle">选择需要管理的内容</text>
    </view>

    <view class="menu-list">
      <view
        class="card menu-item {{item.superOnly && role !== 'super' ? 'menu-item-disabled' : ''}}"
        wx:for="{{menuList}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="openMenu"
      >
        <view class="menu-item-main">
          <text class="menu-item-title">{{item.title}}</text>
          <text class="menu-item-description">{{item.description}}</text>
        </view>
        <text wx:if="{{!item.superOnly || role === 'super'}}" class="menu-item-arrow">›</text>
        <text wx:else class="menu-item-tag">仅超级管理员</text>
      </view>
    </view>
  </view>
</view>
