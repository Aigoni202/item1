/* pages/admin/login/login.wxss */
page {
  background: #F6F8FA;
}

.admin-login-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.admin-login-content {
  width: 100%;
  max-width: 640rpx;
  text-align: center;
}

.admin-login-mark {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  color: #FFFFFF;
  background: #0969DA;
  border-radius: 6px;
  font-size: 42rpx;
  font-weight: 600;
}

.admin-login-title {
  color: #24292F;
  font-size: 44rpx;
  font-weight: 600;
}

.admin-login-subtitle {
  margin-top: 10rpx;
  color: #57606A;
  font-size: 26rpx;
}

.admin-login-card {
  margin-top: 48rpx;
  text-align: left;
}

.field + .field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #24292F;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  color: #24292F;
  background: #FFFFFF;
  border: 1px solid #D0D7DE;
  border-radius: 6px;
  font-size: 28rpx;
}

.field-input:focus {
  border-color: #0969DA;
}

.login-button {
  width: 100%;
  margin-top: 36rpx;
}
