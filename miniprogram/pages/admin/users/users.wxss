/* 管理后台用户页样式 */
page {
  background: #f6f8fa;
}

.users-page {
  min-height: 100vh;
}

.section-heading {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.section-heading .section-subtitle {
  margin-top: 8rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  color: #24292f;
  background: #fff;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  font-size: 25rpx;
}

.search-button {
  min-width: 132rpx;
  min-height: 80rpx;
  padding: 0 18rpx;
  font-size: 25rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-item {
  padding: 24rpx;
}

.user-main {
  min-width: 0;
}

.user-title {
  color: #24292f;
  font-size: 29rpx;
  font-weight: 600;
}

.user-openid {
  margin-top: 8rpx;
  overflow: hidden;
  color: #57606a;
  font-family: monospace;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-date {
  margin-top: 6rpx;
  color: #57606a;
  font-size: 21rpx;
}

.user-admin-status {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.admin-yes {
  color: #1a7f37;
  background: #dafbe1;
}

.admin-no {
  color: #57606a;
  background: #f6f8fa;
}

.user-stats {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #d0d7de;
}

.stat-line {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: #57606a;
  font-size: 19rpx;
  text-align: center;
}

.stat-line text:last-child {
  color: #0969da;
  font-size: 27rpx;
  font-weight: 600;
}

.stat-line .danger-text,
.danger-text {
  color: #cf222e !important;
}

.load-more {
  margin-top: 20rpx;
}

.load-more-button {
  width: 100%;
  min-height: 76rpx;
}

.list-total {
  padding: 24rpx 0;
  color: #57606a;
  font-size: 22rpx;
  text-align: center;
}
