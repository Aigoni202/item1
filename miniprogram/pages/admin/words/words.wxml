<!-- pages/admin/words/words.wxml -->
<view class="page words-page">
  <view class="page-content">
    <view class="import-header">
      <text class="section-title">单词批量导入</text>
      <text class="section-subtitle">每批 90 条，自动分批导入，降低云函数超时风险。</text>
    </view>

    <view class="card import-card">
      <button class="btn-secondary choose-file-button" bindtap="selectFile">选择 JSON 文件</button>
      <view wx:if="{{fileName}}" class="file-name">已选：{{fileName}}</view>

      <textarea
        class="import-textarea"
        value="{{importJson}}"
        maxlength="-1"
        placeholder="也可以粘贴 JSON 数组，例如 [{&quot;no&quot;:1,&quot;word&quot;:&quot;abandon&quot;,&quot;meaning&quot;:&quot;放弃&quot;,&quot;level&quot;:4}]"
        bindinput="onImportInput"
      ></textarea>

      <button
        class="btn-primary import-button"
        bindtap="startImport"
        disabled="{{importing}}"
        loading="{{importing}}"
      >
        开始导入
      </button>

      <view wx:if="{{importTotal}}" class="import-progress">
        进度：{{current}} / {{importTotal}}（{{percent}}%）
      </view>
      <progress wx:if="{{importTotal}}" percent="{{percent}}" show-info activeColor="#0969DA"></progress>
      <view wx:if="{{importMessage}}" class="import-message">{{importMessage}}</view>
    </view>
  </view>
</view>
