/* pages/admin/words/words.wxss */
page {
  background: #F6F8FA;
}

.words-page {
  min-height: 100vh;
}

.import-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.import-header .section-subtitle {
  margin-top: 10rpx;
}

.import-card {
  padding: 32rpx;
}

.choose-file-button {
  min-height: 80rpx;
}

.file-name {
  margin-top: 16rpx;
  color: #57606A;
  font-size: 24rpx;
  line-height: 1.45;
}

.import-textarea {
  width: 100%;
  height: 480rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  color: #24292F;
  background: #F6F8FA;
  border: 1px solid #D0D7DE;
  border-radius: 6px;
  font-family: monospace;
  font-size: 22rpx;
  line-height: 1.5;
}

.import-button {
  margin-top: 24rpx;
}

.import-progress {
  margin-top: 20rpx;
  color: #0969DA;
  font-size: 24rpx;
  text-align: center;
}

progress {
  margin: 16rpx 0;
}

.import-message {
  margin-top: 12rpx;
  color: #57606A;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}
