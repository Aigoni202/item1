page { background: #fff; }
.ai-page { min-height: 100vh; padding: 30rpx 22rpx calc(136rpx + env(safe-area-inset-bottom)); color: #22252a; }.ai-heading { animation: ai-in 260ms ease both; }.ai-title { display: block; font-size: 42rpx; font-weight: 800; }.ai-subtitle { display: block; max-width: 600rpx; margin-top: 8rpx; color: #6d736f; font-size: 23rpx; line-height: 1.5; }
.ai-hero { position: relative; display: flex; min-height: 280rpx; align-items: center; margin-top: 26rpx; overflow: hidden; padding: 28rpx 28rpx 28rpx 250rpx; border-radius: 32rpx; background: #147d73; color: #fff; animation: ai-in 300ms 40ms ease both; }.ai-hero image { position: absolute; left: 22rpx; bottom: -8rpx; width: 218rpx; height: 238rpx; }.hero-copy { position: relative; z-index: 2; }.hero-tag { display: inline-block; padding: 7rpx 14rpx; border-radius: 999rpx; background: #f5c84c; color: #29302d; font-size: 18rpx; font-weight: 800; }.hero-title { display: block; margin-top: 18rpx; font-size: 35rpx; font-weight: 800; }.hero-subtitle { display: block; margin-top: 8rpx; font-size: 20rpx; line-height: 1.45; opacity: .84; }
.ai-list { margin-top: 16rpx; }.ai-item { display: flex; min-height: 116rpx; align-items: center; margin-top: 12rpx; padding: 18rpx 20rpx; border: 1rpx solid #ece9e1; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(34,37,42,.05); animation: ai-in 300ms 90ms ease both; transition: transform 140ms ease, opacity 140ms ease; }.ai-item:active { opacity: .76; transform: scale(.985); }.item-mark { width: 18rpx; height: 62rpx; margin-right: 18rpx; border-radius: 999rpx; }.jade { background: #70c3aa; }.coral { background: #ee8c76; }.yellow { background: #f5c84c; }.item-copy { flex: 1; }.item-copy text:first-child { display: block; font-size: 27rpx; font-weight: 800; }.item-copy text:last-child { display: block; margin-top: 5rpx; color: #68706c; font-size: 20rpx; }.ai-item image { width: 26rpx; height: 26rpx; }
@keyframes ai-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
