/* pages/collected/collected.wxss */
page {
  background: #F6F8FA;
}

.collected-page {
  min-height: 100vh;
}

.section-heading {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.section-heading .section-subtitle {
  margin-top: 8rpx;
}

.search-row {
  display: flex;
}

.search-input {
  flex: 1;
  height: 76rpx;
  min-width: 0;
  padding: 0 20rpx;
  color: #24292F;
  background: #FFFFFF;
  border: 1px solid #D0D7DE;
  border-radius: 6px;
  font-size: 26rpx;
}

.search-button {
  width: 120rpx;
  min-height: 76rpx;
  margin-left: 16rpx;
  padding: 0;
  font-size: 25rpx;
}

.sort-row {
  display: flex;
  margin-top: 20rpx;
  padding: 4rpx;
  background: #FFFFFF;
  border: 1px solid #D0D7DE;
  border-radius: 6px;
}

.sort-item {
  flex: 1;
  padding: 16rpx 0;
  color: #57606A;
  text-align: center;
  font-size: 24rpx;
}

.sort-item-active {
  color: #0969DA;
  background: #DDF4FF;
  border-radius: 4px;
  font-weight: 600;
}

.result-tip {
  margin: 28rpx 0 14rpx;
  color: #57606A;
  font-size: 23rpx;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-item {
  position: relative;
  display: flex;
  min-height: 152rpx;
  align-items: center;
  padding: 24rpx;
}

.word-main {
  width: 34%;
  min-width: 0;
  flex: 0 0 34%;
}

.word-title {
  overflow: hidden;
  color: #24292F;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #57606A;
  font-size: 21rpx;
}

.word-meaning {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
  color: #24292F;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.55;
  word-break: break-word;
}

.word-pos {
  flex: 0 0 auto;
  color: #0969DA;
  font-weight: 600;
}

.remove-button {
  display: flex;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  min-width: 48rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  overflow: hidden;
  color: #CF222E;
  background: #FFF1F0;
  border: 1px solid #FFB8B5;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
}

.load-more {
  padding: 28rpx 0 40rpx;
  color: #0969DA;
  text-align: center;
  font-size: 25rpx;
}

.empty-login-button {
  width: 180rpx;
  min-height: 72rpx;
  margin: 24rpx auto 0;
  font-size: 26rpx;
}
