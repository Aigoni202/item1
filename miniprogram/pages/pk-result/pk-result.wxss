/* 好友 PK 结果页样式 */
page {
  background: linear-gradient(180deg, #f7f9ff 0%, #f6f8fa 44%, #ffffff 100%);
}

.pk-result-page {
  min-height: 100vh;
}

.result-heading {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.result-heading .section-subtitle {
  margin-top: 8rpx;
}

.outcome-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(31, 35, 40, 0.08) !important;
}

.outcome-card.win {
  background: #dafbe1;
  border-color: #aceebb;
}

.outcome-card.lose {
  background: #ffebe9;
  border-color: #ff8182;
}

.outcome-card.draw {
  background: #ddf4ff;
  border-color: #b6e3ff;
}

.outcome-text {
  color: #24292f;
  font-size: 42rpx;
  font-weight: 700;
}

.score-row {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin-top: 26rpx;
}

.result-player {
  display: flex;
  min-width: 160rpx;
  flex-direction: column;
  align-items: center;
}

.result-player-label {
  color: #57606a;
  font-size: 24rpx;
}

.result-score {
  margin-top: 4rpx;
  color: #24292f;
  font-size: 56rpx;
  font-weight: 700;
}

.score-separator {
  color: #57606a;
  font-size: 32rpx;
  font-weight: 600;
}

.section-heading {
  display: flex;
  flex-direction: column;
  margin: 42rpx 0 20rpx;
}

.section-heading .section-subtitle {
  margin-top: 8rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-item {
  width: 100%;
  padding: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 40, 0.05) !important;
}

.result-item-head {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
}

.result-number {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  align-items: center;
  justify-content: center;
  color: #0969da;
  background: #ddf4ff;
  border: 1px solid #b6e3ff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 700;
}

.result-word-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 16rpx;
}

.word-line {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.word-title {
  color: #24292f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  word-break: break-word;
}

.word-phonetic {
  color: #57606a;
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-word;
}

.word-meaning {
  display: block;
  margin-top: 10rpx;
  color: #57606a;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-word;
}

.result-status-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid #d0d7de;
}

.result-status {
  display: flex;
  min-width: 0;
  height: 64rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 18rpx;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  background: #f6f8fa;
}

.status-label {
  color: #57606a;
  font-size: 24rpx;
  font-weight: 600;
}

.status-icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
}

.status-card-correct {
  border-color: #aceebb;
  background: #dafbe1;
}

.status-card-wrong {
  border-color: #ff8182;
  background: #ffebe9;
}

.status-card-correct .status-icon {
  color: #1a7f37;
  background: rgba(45, 164, 78, 0.14);
}

.status-card-wrong .status-icon {
  color: #cf222e;
  background: rgba(207, 34, 46, 0.12);
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-bottom: 24rpx;
}

.action-button {
  flex: 1;
}
