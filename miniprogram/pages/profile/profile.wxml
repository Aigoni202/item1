<!-- pages/profile/profile.wxml -->
<view class="page">
  <view class="page-content">
    <view class="section-heading">
      <text class="section-title">我的</text>
      <text class="section-subtitle">查看你的学习概况</text>
    </view>

    <view class="card user-card">
      <view class="avatar-placeholder">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-image" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else class="avatar-text">微</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName}}</text>
        <text class="user-description">{{loggedIn ? "微信用户" : "登录后同步学习数据"}}</text>
      </view>
    </view>

    <view wx:if="{{!loggedIn}}" class="login-entry card">
      <view class="login-entry-main">
        <view class="login-entry-icon">✓</view>
        <view>
          <view class="admin-entry-title">保存你的学习进度</view>
          <view class="admin-entry-description">登录后同步收藏、生词、错题和好友 PK 记录。</view>
        </view>
      </view>
      <button
        class="btn-primary profile-login-button"
        loading="{{loginLoading}}"
        disabled="{{loginLoading}}"
        bindtap="handleLogin"
      >立即登录</button>
    </view>

    <view class="section-heading statistics-heading">
      <text class="section-title">学习统计</text>
    </view>

    <view class="statistics-grid">
      <view class="card statistic-item" wx:for="{{statistics}}" wx:key="label">
        <text class="statistic-value">{{item.value}}</text>
        <text class="statistic-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{loggedIn && isAdmin}}" class="admin-entry card" bindtap="openAdmin">
      <view>
        <view class="admin-entry-title">管理后台</view>
        <view class="admin-entry-description">管理单词和词库内容</view>
      </view>
      <text class="admin-entry-arrow">›</text>
    </view>
  </view>
</view>
