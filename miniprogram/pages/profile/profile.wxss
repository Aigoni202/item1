/* pages/profile/profile.wxss */
page {
  background: #FFFFFF;
}

.section-heading {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.section-heading .section-subtitle {
  margin-top: 8rpx;
}

.user-card {
  display: flex;
  align-items: center;
}

.avatar-placeholder {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #0969DA;
  background: #DDF4FF;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 34rpx;
  font-weight: 600;
}

.user-info {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.user-name {
  color: #24292F;
  font-size: 32rpx;
  font-weight: 600;
}

.user-description {
  margin-top: 8rpx;
  color: #57606A;
  font-size: 24rpx;
}

.statistics-heading {
  margin-top: 48rpx;
  margin-bottom: 24rpx;
}

.statistics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.statistic-item {
  display: flex;
  min-height: 148rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.statistic-value {
  color: #0969DA;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
}

.statistic-label {
  margin-top: 12rpx;
  color: #57606A;
  font-size: 24rpx;
}

.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.login-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  background: #F6F8FA;
}

.login-entry-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 18rpx;
}

.login-entry-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  color: #0969DA;
  background: #DDF4FF;
  border: 1px solid #B6E3FF;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-login-button {
  width: 176rpx;
  min-height: 72rpx;
  flex-shrink: 0;
  font-size: 26rpx;
}

.admin-entry:active {
  background: #F6F8FA;
}

.admin-entry-title {
  color: #24292F;
  font-size: 29rpx;
  font-weight: 600;
}

.admin-entry-description {
  margin-top: 8rpx;
  color: #57606A;
  font-size: 24rpx;
}

.admin-entry-arrow {
  color: #0969DA;
  font-size: 42rpx;
  line-height: 1;
}

@media (min-width: 600px) {
  .statistics-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
.page { padding-bottom: calc(156rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(156rpx + env(safe-area-inset-bottom)); }
