page { background: #fff; }
.study-page { min-height: 100vh; padding: 30rpx 22rpx calc(136rpx + env(safe-area-inset-bottom)); color: #22252a; }
.study-heading { animation: study-in 260ms ease both; }.study-title { display: block; font-size: 42rpx; font-weight: 800; }.study-subtitle { display: block; margin-top: 8rpx; color: #6d736f; font-size: 23rpx; }
.study-hero { position: relative; min-height: 230rpx; margin-top: 26rpx; overflow: hidden; padding: 34rpx 30rpx; border-radius: 30rpx; background: #147d73; color: #fff; animation: study-in 300ms 40ms ease both; transition: transform 140ms ease, opacity 140ms ease; }
.study-hero:active,.study-card:active { opacity: .86; transform: scale(.98); }.study-hero image { position: absolute; top: 0; right: -110rpx; width: 440rpx; height: 100%; opacity: .92; }.study-hero view { position: relative; z-index: 2; }.hero-kicker { display: inline-block; padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 19rpx; font-weight: 700; }.hero-title { display: block; margin-top: 20rpx; font-size: 38rpx; font-weight: 800; }.hero-subtitle { display: block; margin-top: 8rpx; font-size: 21rpx; opacity: .82; }
.study-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; margin-top: 16rpx; }.study-card { position: relative; height: 190rpx; overflow: hidden; padding: 20rpx; border: 1rpx solid rgba(34,37,42,.07); border-radius: 25rpx; animation: study-in 300ms 90ms ease both; transition: transform 140ms ease, opacity 140ms ease; }.study-card image { position: absolute; right: -2rpx; bottom: -8rpx; width: 122rpx; height: 106rpx; }.card-title { position: relative; z-index: 2; display: block; font-size: 29rpx; font-weight: 800; }.card-copy { position: relative; z-index: 2; display: block; margin-top: 7rpx; color: #59605c; font-size: 19rpx; }.mint { background: #e9f7f0; }.coral { background: #fff0ed; }.yellow { background: #fff8df; }.green { background: #edf8f3; }
@keyframes study-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
